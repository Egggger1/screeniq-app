<?xml version="1.0" encoding="utf-8"?>
<!-- 双保险：allowBackup=false 之外，云备份与换机迁移都不带走配置/日志/密钥。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
